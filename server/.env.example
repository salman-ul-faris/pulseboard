# PulseBoard Server Environment Configuration (Render)
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@hostname:5432/pulseboard
SESSION_SECRET=generate_a_secure_32_byte_string_for_production
CLIENT_ORIGIN=https://pulseboard.vercel.app
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Persistent Image Storage (Cloudinary)
# Required on Render for persistent avatar uploads across dyno deploys & restarts
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
