# PulseBoard Server Environment Configuration (Netlify Functions & Cloud Deployments)
NODE_ENV=production
PORT=5000

# Persistent PostgreSQL (Neon, Supabase, Render Postgres, AWS RDS)
DATABASE_URL=postgresql://user:password@hostname:5432/pulseboard?sslmode=require

# Session Security (32+ character random string)
SESSION_SECRET=generate_a_secure_32_byte_string_for_production

# Same-Origin Site URL on Netlify
CLIENT_ORIGIN=https://pulseboard.netlify.app
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Serverless Connection Pool Tuning (prevents connection exhaustion)
DB_POOL_MAX=2

# Persistent Image Storage (Cloudinary - Production Profile Picture Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

