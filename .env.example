# PulseBoard Environment Configuration
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulseboard
SESSION_SECRET=pulseboard_super_secret_session_key_32bytes_min!
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DB_POOL_MAX=10

# Persistent Image Storage (Cloudinary)
# Optional in local dev (falls back to data/uploads/avatars). Required for production cloud storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

